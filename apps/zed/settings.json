    "mcp-server-supabase": {
      "enabled": false,
      "settings": {
        "supabase_access_token": "sbp_e903d57eb1aea9700eb285cb7228c8a2604a92ec",
        "read_only": true,
        "project_ref": "bfaqdyadcpaetelvpbva",
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["ruff", "..."],
    },
  },
  "git": {
    "blame": { "show_avatar": true },
    "gutter_debounce": 100,
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
    "hunk_style": "staged_hollow",
  },
}
