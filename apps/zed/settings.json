// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "agent_servers": {
    "claude": {
      "default_mode": "acceptEdits",
    },
  },
  "ssh_connections": [
    {
      "host": "jetson",
      "args": [],
      "projects": [
        {
          "paths": ["/home/gianpaj/tmp"],
        },
        {
          "paths": ["/ssd/jetson-containers"],
        },
      ],
    },
    {
      "host": "staging.bring4you.com",
      "args": [],
      "projects": [],
    }
  ],
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "disabled_globs": [".env", "exercises/**/*.rs"],
  },
  "vim_mode": false,
  "show_edit_predictions": true,
  "auto_update": false,
  "agent": {
    "favorite_models": [
      {
        "provider": "anthropic",
        "model": "claude-haiku-4-5-latest",
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-4-5-latest",
      },
      {
        "provider": "x_ai",
        "model": "grok-4-1-fast-reasoning",
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-4-5-thinking-latest",
      },
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-4.5",
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.5",
      },
      {
        "provider": "anthropic",
        "model": "claude-opus-4-6-latest",
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.2-codex",
      },
    ],
    "profiles": {
      "write-no-md-files": {
        "name": "Write-no-md-files",
        "tools": {
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "list_directory": true,
          "project_notifications": false,
          "move_path": true,
          "now": true,
          "find_path": true,
          "read_file": true,
          "open": true,
          "grep": true,
          "terminal": true,
          "thinking": true,
          "web_search": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {},
      },
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
    },
    "default_profile": "write",
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.5",
    },
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      // "api_url": "http://100.126.22.13:11434",
      "available_models": [
        {
          "name": "qwen3:8b",
          "display_name": "qwen3:8b",
          "max_tokens": 40960,
          "supports_tools": true,
          "supports_thinking": true,
          "supports_images": true,
        },
      ],
    },
  },
  "theme": "One Dark",
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "tab_size": 2,
  "file_types": {
    "JavaScript": ["marko"],
    "Ruby": ["Fastfile"],
    "C": ["m"],
    "Git Ignore": [".vercelignore"],
    "Shell Script": [".aliases"]
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "project_panel": {
    "hide_root": true,
    "hide_hidden": false,
    "dock": "right",
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "show_whitespaces": "selection",
  // https://github.com/zed-industries/zed/pull/31432 - Nope. Same as Cmd + .
  "inline_code_actions": false,
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
  },
  // "lsp": {
  //   "deno": {
  //     "settings": {
  //       "deno": {
  //         "enable": true
  //       }
  //     }
  //   }
  // },
  "context_servers": {
    "chrome-devtools": {
      "enabled": false,
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--yes",
        "--browser-url=http://127.0.0.1:9222",
      ],
    },
    "ck": {
      "enabled": false,
      "command": "ck",
      "args": ["--serve"],
    },
    "mcp-server-context7": {
      "enabled": true,
      "settings": {},
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["ruff", "..."],
    },
  },
  "git": {
    "blame": { "show_avatar": true },
    "gutter_debounce": 100,
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
    "hunk_style": "staged_hollow",
  },
}
