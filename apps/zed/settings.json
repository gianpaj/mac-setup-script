// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "inline_completions": {
    "disabled_globs": [".env", "exercises/**/*.rs"]
  },
  "vim_mode": false,
  // "features": {
  //   "inline_completion_provider": "supermaven"
  // },
  "show_inline_completions": true,
  "auto_update": false,
  "assistant": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-3-5-sonnet"
    },
    "version": "2"
  },
  "language_models": {
    "ollama": {
      "api_url": "http://192.168.1.161:11434",
      // "api_url": "http://100.126.22.13:11434",
      "low_speed_timeout_in_seconds": 120,
      "available_models": [
        {
          "name": "llama3.2:3b",
          "display_name": "llama3.2 3b",
          "max_tokens": 131072
        },
        {
          "name": "llama3.2:1b",
          "display_name": "llama3.2 1b",
          "max_tokens": 131072
        }
      ]
    }
  },
  "theme": "One Dark",
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "tab_size": 2,
  "file_types": {
    "JavaScript": ["marko"],
    "Ruby": ["Fastfile"],
    "C": ["m"],
    "Shell Script": [".aliases"]
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "right"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "show_whitespaces": "selection"
}
