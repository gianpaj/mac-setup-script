  "edit_predictions": {
    "mode": "subtle",
    "disabled_globs": [".env", "exercises/**/*.rs"],
    "codestral": {
      "model": "codestral-latest",
      "max_tokens": 150
    }
  },
  "vim_mode": false,
  "features": {
    "edit_prediction_provider": "zed"
