  "theme": "One Dark",
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "tab_size": 2,
  "file_types": {
    "JavaScript": ["marko"],
    "Ruby": ["Fastfile"],
    "C": ["m"],
