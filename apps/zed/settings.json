// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/build",
  ],
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
      "default_mode": "acceptEdits",
    },
  },
  "ssh_connections": [
    {
      "host": "jetson",
      "args": [],
      "projects": [
        {
          "paths": ["/home/gianpaj/tmp"],
        },
        {
          "paths": ["/ssd/jetson-containers"],
        },
      ],
    },
    {
      "host": "staging.bring4you.com",
      "args": [],
      "projects": [],
    },
  ],
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "disabled_globs": [".env", "exercises/**/*.rs"],
  },
  "vim_mode": false,
  "show_edit_predictions": true,
  "auto_update": false,
  "agent": {
    "show_turn_stats": true,
    "single_file_review": true,
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
      "enable_thinking": false,
    },
    "profiles": {},
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "move_path": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^sexyvoice/docs/"
            }
          ]
        },
        "fetch": {
          "default": "allow",
        },
        "create_directory": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^sexyvoice/supabase/",
            },
          ],
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5-latest",
      "enable_thinking": false,
    },
    "thread_summary_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5.4",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-4.5",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
        "enable_thinking": false
      },
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-5-1m-context-latest",
        "enable_thinking": false
      },
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6-latest",
        "enable_thinking": false
      }
    ],
    "model_parameters": [],
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "name": "liquid/lfm2-24b-a2b",
          "display_name": "liquid/lfm2-24b-a2b",
          "max_tokens": 32768,
          "supports_tools": true,
          "supports_thinking": true,
          "supports_images": false,
        },
      ],
    },
  },
  "theme": "One Dark",
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "tab_size": 2,
  "file_types": {
    "JavaScript": ["marko"],
    "Ruby": ["Fastfile"],
    "C": ["m"],
    "Git Ignore": [".vercelignore"],
    "Shell Script": [".aliases"],
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "project_panel": {
    "hide_root": true,
    "hide_hidden": false,
    "dock": "right",
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "show_whitespaces": "selection",
  // https://github.com/zed-industries/zed/pull/31432 - Nope. Same as Cmd + .
  "inline_code_actions": false,
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
  },
  // "lsp": {
  //   "deno": {
  //     "settings": {
  //       "deno": {
  //         "enable": true
  //       }
  //     }
